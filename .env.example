# ---- Chain ingestion -------------------------------------------------
# Comma separated failover list of Steem HTTP RPC endpoints (round-robin + health checks)
STEEM_RPC_ENDPOINTS=https://api.steemit.com,https://api.steemyy.com,https://api.moecki.online
# Milliseconds between head-of-chain polls (3000 = 3s)
BLOCK_POLL_INTERVAL_MS=3000
# Rolling undo/redo buffer depth used for micro-fork (re-org) handling
UNDO_BUFFER_DEPTH=30
# custom_json operation id this engine consumes. Any other id is ignored at the
# parser — a different value (e.g. sce-testnet1) gives an isolated network; see
# docs/TESTNET.md.
SCE_OP_ID=sce-mainnet1
# Optional: start ingesting from this height instead of the DB cursor
# START_BLOCK_HEIGHT=

# ---- Database --------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sce?schema=public
# auto     = postgres when DATABASE_URL is set, otherwise memory (warns loudly)
# postgres = require DATABASE_URL + a reachable server (production; refuses to start otherwise)
# memory   = in-process store, state lost on restart (tests/demo)
STORAGE=auto
# Only needed when the DB lives on a separate Docker network (docker-compose.dbnet.yml):
# DB_NETWORK=<network, e.g. someproject_default>

# ---- APIs ------------------------------------------------------------
PORT=4000
GRAPHQL_PATH=/graphql
WS_PORT=4001
REST_ENABLED=true
GRAPHQL_ENABLED=true

# ---- Security / hardening --------------------------------------------
# Blocks within this many heights of the known head are cross-checked against a
# second RPC endpoint before being applied (majority of three resolves a split view;
# an unresolvable split stalls loudly instead of applying a possibly fabricated
# block). 0 disables; deep-history sync is exempt by construction; ignored entirely
# when only one endpoint is configured (nothing to compare against).
QUORUM_VERIFY_DEPTH=50
# Per-IP HTTP request budget for REST + GraphQL (requests/minute, token bucket).
# /health is exempt so orchestrators can never be rate limited out. 0 disables.
RATE_LIMIT_RPM=600
# Reverse-proxy hops in front of the HTTP server (X-Forwarded-For trust). 1 = one
# proxy (Traefik/Dokploy) and cannot be spoofed by clients; irrelevant when the
# engine is directly exposed (no header ⇒ socket address).
TRUST_PROXY_HOPS=1
# Hard cap on simultaneous WebSocket connections (0 = unlimited).
WS_MAX_CLIENTS=500

# ---- Sandbox ---------------------------------------------------------
# isolated-vm  = V8 isolate (preferred, hard memory/time limits)
# node-vm      = Node vm fallback with the exact same contract source
SANDBOX_PROVIDER=auto
SANDBOX_TIMEOUT_MS=1000
SANDBOX_MEMORY_LIMIT_MB=128
# Throw instead of silently continuing if the chain re-orgs deeper than the buffer
FAIL_ON_DEEP_FORK=true

# ---- Runtime ---------------------------------------------------------
LOG_LEVEL=info
# Optional build stamp reported at /health, / and /api/v1/status (set it to the
# deployed git revision, e.g. SCE_BUILD_SHA=$(git rev-parse --short HEAD)).
# Empty = the field stays null.
# SCE_BUILD_SHA=
