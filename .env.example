# ---- Chain ingestion -------------------------------------------------
# Comma separated failover list of Steem HTTP RPC endpoints (round-robin + health checks)
STEEM_RPC_ENDPOINTS=https://api.steemit.com,https://api.steemyy.com,https://api.moecki.online
# Seconds between head-of-chain polls
BLOCK_POLL_INTERVAL_MS=3000
# Rolling undo/redo buffer depth used for micro-fork (re-org) handling
UNDO_BUFFER_DEPTH=30
# custom_json operation id this engine consumes
SCE_OP_ID=sce-mainnet1
# Optional: start ingesting from this height instead of the DB cursor
# START_BLOCK_HEIGHT=

# ---- Database --------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/steemcraft?schema=public
# auto     = postgres when DATABASE_URL is set, otherwise memory (warns loudly)
# postgres = require DATABASE_URL + a reachable server (production; refuses to start otherwise)
# memory   = in-process store, state lost on restart (tests/demo)
STORAGE=auto
# Only needed when the DB lives on a separate Docker network (docker-compose.dbnet.yml):
# DB_NETWORK=<network, e.g. someproject_default>

# ---- APIs ------------------------------------------------------------
PORT=4000
GRAPHQL_PATH=/graphql
WS_PORT=4001
REST_ENABLED=true
GRAPHQL_ENABLED=true

# ---- Sandbox ---------------------------------------------------------
# isolated-vm  = V8 isolate (preferred, hard memory/time limits)
# node-vm      = Node vm fallback with the exact same contract source
SANDBOX_PROVIDER=auto
SANDBOX_TIMEOUT_MS=1000
SANDBOX_MEMORY_LIMIT_MB=128
# Throw instead of silently continuing if the chain re-orgs deeper than the buffer
FAIL_ON_DEEP_FORK=true

# ---- Runtime ---------------------------------------------------------
LOG_LEVEL=info
